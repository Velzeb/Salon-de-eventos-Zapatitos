{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dbZapatitos;Username=postgres;Password=YOUR_PASSWORD_HERE"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "ZapatitosAPI",
    "Audience": "ZapatitosApp",
    "ExpiryMinutes": 1440
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "CloudflareR2": {
    "AccessKeyId": "YOUR_R2_ACCESS_KEY_ID",
    "SecretAccessKey": "YOUR_R2_SECRET_ACCESS_KEY",
    "Endpoint": "https://YOUR_CLOUDFLARE_ID.r2.cloudflarestorage.com",
    "BucketName": "zapatitos-fotosyvideos",
    "PublicUrl": "https://YOUR_PUBLIC_R2_URL.com"
  },
  "Chatbot": {
    "Provider": "Gemini",
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "DefaultModel": "gemini-2.5-flash-lite"
  }
}
